# ── Database ────────────────────────────────────────────────────────────────
# Local development (SQLite — create the db folder first: mkdir -p db)
DATABASE_URL=file:../db/custom.db

# Vercel / hosted Postgres (Neon, Vercel Postgres, Supabase, Railway…) —
# pair with prisma/schema.postgres.prisma (see DEPLOY.md)
# DATABASE_URL=postgresql://user:password@host/db?sslmode=require

# ── Unlock payment destination (optional env overrides) ─────────────────────
# If unset, the first registered user (the "operator") configures these in the
# app's Settings dialog. Env vars, when present, take precedence.
# UNLOCK_LIGHTNING_ADDRESS=you@wallet.com
# ZAPRITE_PAY_LINK=https://checkout.zaprite.com/pay/your-link

# ── Reseller terms & white-label (optional env overrides) ───────────────────
# Same precedence as above: env beats the operator's Settings values.
# UNLOCK_SATS=21000            # one-time unlock price (whole sats, >= 1000)
# FREE_INVOICES=3              # free invoices per new account
# BRAND_NAME=SatInvoice        # white-label instance name (max 40 chars)
# BRAND_LOGO=https://…/logo.png  # replaces the bolt in the header
# WALLET_REFERRAL_URL=https://getalby.com/invited-by/…  # "Get a free wallet" link (default: the built-in Alby referral)

# ── Payment confirmation & security (optional) ──────────────────────────────
# Zaprite: when set, the webhook only accepts calls with ?secret=<value>
# (register https://<domain>/api/webhooks/zaprite?secret=<value> in Zaprite).
# ZAPRITE_WEBHOOK_SECRET=change-me-to-a-long-random-string
# Lightning unlocks verify automatically (LUD-21). Set to true ONLY if you want
# the "I've paid" button to unlock without verification (trust mode).
# ALLOW_SELF_CONFIRM=false
# Public origin used in share/email links (defaults to the request origin).
# APP_URL=https://invoices.example.com

# ── Email delivery (optional) ───────────────────────────────────────────────
# Without these, the email dialog falls back to "Open in email app" (mailto).
# Any SMTP provider works: Resend (smtp.resend.com), Gmail app password,
# Postmark, Mailgun, your own server…
# SMTP_HOST=smtp.resend.com
# SMTP_PORT=587
# SMTP_USER=resend
# SMTP_PASS=re_xxxxxxxxxxxx
# MAIL_FROM="SatInvoice <invoices@yourdomain.com>"
# SMTP_SECURE=false
